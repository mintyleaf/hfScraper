{
  "endpoint": "https://huggingface.co",
  "output_dir": "results-2025-production",
  "logging": {
    "level": "info",
    "file": "catalog.log.jsonl",
    "stderr": true,
    "http_requests": false,
    "skipped_records": false
  },
  "scan": {
    "now": "",
    "page_size": 1000,
    "max_pages": 0,
    "require_weights": true,
    "resolve_base_parameters": false,
    "resolve_reported_compute": true,
    "resolve_scratch_claims": true,
    "fetch_individual_readmes": false,
    "catalog_checkpoint": "cache/catalog-2025.json.gz",
    "bulk_model_cards_urls": [
      "https://huggingface.co/datasets/librarian-bots/model_cards_with_metadata/resolve/refs%2Fconvert%2Fparquet/default/train/0000.parquet",
      "https://huggingface.co/datasets/librarian-bots/model_cards_with_metadata/resolve/refs%2Fconvert%2Fparquet/default/train/0001.parquet",
      "https://huggingface.co/datasets/librarian-bots/model_cards_with_metadata/resolve/refs%2Fconvert%2Fparquet/default/train/0002.parquet",
      "https://huggingface.co/datasets/librarian-bots/model_cards_with_metadata/resolve/refs%2Fconvert%2Fparquet/default/train/0003.parquet",
      "https://huggingface.co/datasets/librarian-bots/model_cards_with_metadata/resolve/refs%2Fconvert%2Fparquet/default/train/0004.parquet"
    ],
    "bulk_model_cards_file": "cache/model-cards.parquet",
    "timeout_seconds": 45,
    "retries": 8,
    "quiet": false
  },
  "owners": {
    "enabled": false,
    "workers": 12
  },
  "compute_profiles": [
    {
      "name": "formula_txt_h100",
      "description": "formula.txt: 20 tokens/parameter, 6ND FLOPs, H100 989 TFLOPS at 40% efficiency and USD 1.85/GPU-hour",
      "gpu_name": "NVIDIA H100",
      "gpu_tflops": 989,
      "efficiency": 0.4,
      "gpu_hour_cost_usd": 1.85,
      "tokens_per_parameter": 20,
      "machines": 1,
      "gpus_per_machine": 1,
      "finetune_compute_fraction": 0
    }
  ],
  "selections": [
    {
      "name": "all_2025_models_with_training_cost",
      "description": "Calendar 2025: explicit scratch models estimated by formula.txt; fine-tunes/adapters counted only with reported compute or cost",
      "created_from": "2025-01-01",
      "created_to": "2025-12-31",
      "model_kinds": ["base", "finetune", "adapter"],
      "sort_by": "repo_id",
      "sort_direction": "asc",
      "limit": 0,
      "compute_profiles": ["formula_txt_h100"],
      "require_reported_compute": false,
      "require_reported_derivative_compute": true,
      "require_explicit_scratch_for_base": true,
      "count_reported_derivative_costs": true
    }
  ]
}
