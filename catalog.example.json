{
  "endpoint": "https://huggingface.co",
  "output_dir": "catalog-results",
  "scan": {
    "now": "",
    "page_size": 1000,
    "max_pages": 0,
    "require_weights": true,
    "resolve_base_parameters": true,
    "timeout_seconds": 30,
    "retries": 5,
    "quiet": false
  },
  "owners": {
    "enabled": true,
    "workers": 8
  },
  "compute_profiles": [
    {
      "name": "h100_1000x1",
      "gpu_name": "NVIDIA H100",
      "gpu_tflops": 989,
      "efficiency": 0.4,
      "gpu_hour_cost_usd": 1.85,
      "tokens_per_parameter": 20,
      "machines": 1000,
      "gpus_per_machine": 1,
      "finetune_compute_fraction": 0.05
    },
    {
      "name": "h100_256x4",
      "gpu_name": "NVIDIA H100",
      "gpu_tflops": 989,
      "efficiency": 0.4,
      "gpu_hour_cost_usd": 1.85,
      "tokens_per_parameter": 20,
      "machines": 256,
      "gpus_per_machine": 4,
      "finetune_compute_fraction": 0.05
    }
  ],
  "selections": [
    {
      "name": "popular_llm_last_year",
      "description": "Самые скачиваемые новые LLM за 365 дней",
      "lookback_days": 365,
      "pipeline_tags": ["text-generation", "text2text-generation"],
      "model_kinds": ["base", "finetune", "adapter"],
      "exclude_tags": ["gguf", "gptq", "awq", "exl2", "model-merge"],
      "sort_by": "downloads",
      "sort_direction": "desc",
      "limit": 100,
      "compute_profiles": ["h100_1000x1", "h100_256x4"]
    },
    {
      "name": "base_llm_last_year",
      "description": "Популярные base LLM за 365 дней",
      "lookback_days": 365,
      "pipeline_tags": ["text-generation", "text2text-generation"],
      "model_kinds": ["base"],
      "sort_by": "downloads",
      "sort_direction": "desc",
      "limit": 100
    },
    {
      "name": "adapters_last_year",
      "description": "Популярные adapters и LoRA за 365 дней",
      "lookback_days": 365,
      "pipeline_tags": ["text-generation", "text2text-generation"],
      "model_kinds": ["adapter"],
      "sort_by": "downloads",
      "sort_direction": "desc",
      "limit": 100
    },
    {
      "name": "llm_64_128b_last_year",
      "description": "LLM от 64B до 128B за 365 дней",
      "lookback_days": 365,
      "pipeline_tags": ["text-generation", "text2text-generation"],
      "model_kinds": ["base", "finetune", "adapter"],
      "min_parameters_b": 64,
      "max_parameters_b": 128,
      "include_unknown_parameters": false,
      "sort_by": "downloads",
      "sort_direction": "desc",
      "limit": 0,
      "compute_profiles": ["h100_1000x1", "h100_256x4"]
    },
    {
      "name": "llm_7_14b_last_year",
      "description": "LLM от 7B до 14B за 365 дней",
      "lookback_days": 365,
      "pipeline_tags": ["text-generation", "text2text-generation"],
      "model_kinds": ["base", "finetune", "adapter"],
      "min_parameters_b": 7,
      "max_parameters_b": 14,
      "include_unknown_parameters": false,
      "sort_by": "downloads",
      "sort_direction": "desc",
      "limit": 100
    }
  ]
}
