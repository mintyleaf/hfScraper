{
  "endpoint": "https://huggingface.co",
  "output_dir": "results-2025-derivatives-one-percent-local-llm",
  "logging": {
    "level": "info",
    "file": "derivative-one-percent.log.jsonl",
    "stderr": true,
    "http_requests": false,
    "skipped_records": false
  },
  "scan": {
    "now": "",
    "page_size": 1000,
    "max_pages": 0,
    "require_weights": true,
    "resolve_base_parameters": false,
    "resolve_reported_compute": false,
    "resolve_scratch_claims": false,
    "fetch_individual_readmes": false,
    "catalog_checkpoint": "../results-2025-production/cache/catalog-2025.json.gz",
    "bulk_model_cards_urls": [
      "https://huggingface.co/datasets/librarian-bots/model_cards_with_metadata/resolve/refs%2Fconvert%2Fparquet/default/train/0000.parquet",
      "https://huggingface.co/datasets/librarian-bots/model_cards_with_metadata/resolve/refs%2Fconvert%2Fparquet/default/train/0001.parquet",
      "https://huggingface.co/datasets/librarian-bots/model_cards_with_metadata/resolve/refs%2Fconvert%2Fparquet/default/train/0002.parquet",
      "https://huggingface.co/datasets/librarian-bots/model_cards_with_metadata/resolve/refs%2Fconvert%2Fparquet/default/train/0003.parquet",
      "https://huggingface.co/datasets/librarian-bots/model_cards_with_metadata/resolve/refs%2Fconvert%2Fparquet/default/train/0004.parquet"
    ],
    "bulk_model_cards_file": "../results-2025-production/cache/model-cards.parquet",
    "timeout_seconds": 45,
    "retries": 12,
    "quiet": false
  },
  "local_llm": {
    "enabled": true,
    "scope": "text_llm",
    "base_url": "",
    "model": "",
    "api_key_env": "HF_LLM_API_KEY",
    "workers": 2,
    "timeout_seconds": 180,
    "max_input_chars": 16000,
    "cache_file": "cache/derivative-lineage-one-percent-v1.jsonl"
  },
  "derivative_sampling": {
    "enabled": true,
    "base_cost_fraction": 0.01,
    "seed": 2025,
    "sample_per_stratum": 150,
    "census_min_parameters_b": 34,
    "max_targeted_repositories": 12000,
    "artifact_workers": 1,
    "request_interval_ms": 750,
    "artifacts": [],
    "cache_dir": "cache/derivative-artifacts",
    "manifest_file": "derivative-sampling-manifest.json",
    "evidence_file": "derivative-lineage-reviews.json",
    "results_file": "derivative-one-percent-results.json",
    "summary_file": "derivative-one-percent-summary.json",
    "report_file": "DERIVATIVE-ONE-PERCENT-2025-RU.md",
    "bootstrap_iterations": 2000
  },
  "owners": {
    "enabled": false,
    "costed_only": true,
    "workers": 1
  },
  "compute_profiles": [
    {
      "name": "formula_txt_h100",
      "description": "Text base fallback: 20 tokens per parameter; H100-equivalent at USD 1.85/GPU-hour",
      "gpu_name": "NVIDIA H100",
      "gpu_tflops": 989,
      "efficiency": 0.4,
      "gpu_hour_cost_usd": 1.85,
      "tokens_per_parameter": 20,
      "machines": 1,
      "gpus_per_machine": 1,
      "finetune_compute_fraction": 0
    },
    {
      "name": "diffusion_parameter_fallback",
      "description": "Diffusion base fallback: 3 images per parameter and latent sequence length 1024",
      "gpu_name": "NVIDIA H100",
      "gpu_tflops": 989,
      "efficiency": 0.4,
      "gpu_hour_cost_usd": 1.85,
      "tokens_per_parameter": 20,
      "machines": 1,
      "gpus_per_machine": 1,
      "finetune_compute_fraction": 0,
      "diffusion_image_budget": 3,
      "latent_sequence_length": 1024
    }
  ],
  "selections": [
    {
      "name": "public_text_llm_2025_training_derivatives",
      "description": "Public 2025 text fine-tune and adapter candidates reviewed for 1% derivative-cost estimation",
      "created_from": "2025-01-01",
      "created_to": "2025-12-31",
      "target_llm_only": true,
      "exclude_tags": ["diffusers", "stable-diffusion", "text-to-image", "image-to-image", "image-generation", "text-to-video", "video-generation", "computer-vision", "vision-language", "multimodal", "audio", "speech"],
      "model_kinds": ["finetune", "adapter"],
      "sort_by": "repo_id",
      "sort_direction": "asc",
      "limit": 0,
      "compute_profiles": ["formula_txt_h100"],
      "require_reported_compute": false,
      "require_reported_derivative_compute": false,
      "require_explicit_scratch_for_base": false,
      "formula_requires_explicit_scratch": false,
      "count_reported_derivative_costs": false,
      "declared_base_min_likes": 0,
      "declared_base_min_downloads": 0
    },
    {
      "name": "public_diffusion_2025_training_derivatives",
      "description": "Public 2025 diffusion/image fine-tune and adapter candidates reviewed for 1% derivative-cost estimation",
      "created_from": "2025-01-01",
      "created_to": "2025-12-31",
      "target_diffusion_only": true,
      "model_kinds": ["finetune", "adapter"],
      "sort_by": "repo_id",
      "sort_direction": "asc",
      "limit": 0,
      "compute_profiles": ["diffusion_parameter_fallback"],
      "require_reported_compute": false,
      "require_reported_derivative_compute": false,
      "require_explicit_scratch_for_base": false,
      "formula_requires_explicit_scratch": false,
      "count_reported_derivative_costs": false,
      "declared_base_min_likes": 0,
      "declared_base_min_downloads": 0
    }
  ]
}
