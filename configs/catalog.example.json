{
  "endpoint": "https://huggingface.co",
  "output_dir": "catalog-results",
  "logging": {
    "level": "info",
    "file": "catalog.log.jsonl",
    "stderr": true,
    "http_requests": false,
    "skipped_records": false
  },
  "scan": {
    "now": "",
    "page_size": 1000,
    "max_pages": 0,
    "require_weights": true,
    "resolve_base_parameters": true,
    "timeout_seconds": 30,
    "retries": 5,
    "quiet": false
  },
  "owners": {
    "enabled": true,
    "workers": 8
  },
  "compute_profiles": [
    {
      "name": "h100_1000x1",
      "description": "1000 машин по одной H100",
      "gpu_name": "NVIDIA H100",
      "gpu_tflops": 989,
      "efficiency": 0.4,
      "gpu_hour_cost_usd": 1.85,
      "tokens_per_parameter": 20,
      "machines": 1000,
      "gpus_per_machine": 1,
      "finetune_compute_fraction": 0.05
    },
    {
      "name": "h100_256x4",
      "description": "256 машин по четыре H100; всего 1024 GPU",
      "gpu_name": "NVIDIA H100",
      "gpu_tflops": 989,
      "efficiency": 0.4,
      "gpu_hour_cost_usd": 1.85,
      "tokens_per_parameter": 20,
      "machines": 256,
      "gpus_per_machine": 4,
      "finetune_compute_fraction": 0.05
    },
    {
      "name": "diffusion_conservative",
      "description": "Консервативный бюджет для diffusion-моделей",
      "gpu_name": "NVIDIA H100",
      "gpu_tflops": 989,
      "efficiency": 0.4,
      "gpu_hour_cost_usd": 1.85,
      "tokens_per_parameter": 20,
      "machines": 1000,
      "gpus_per_machine": 1,
      "finetune_compute_fraction": 0.05,
      "diffusion_image_budget": 3.0,
      "latent_sequence_length": 1024
    },
    {
      "name": "diffusion_upper",
      "description": "Верхний уровень бюджета для diffusion-моделей",
      "gpu_name": "NVIDIA H100",
      "gpu_tflops": 989,
      "efficiency": 0.4,
      "gpu_hour_cost_usd": 1.85,
      "tokens_per_parameter": 20,
      "machines": 1000,
      "gpus_per_machine": 1,
      "finetune_compute_fraction": 0.05,
      "diffusion_image_budget": 1000.0,
      "latent_sequence_length": 1024
    }
  ],
  "selections": [
    {
      "name": "latest_models",
      "lookback_days": 365,
      "sort_by": "downloads",
      "sort_direction": "desc",
      "limit": 100
    },
    {
      "name": "base_llm",
      "description": "Самые популярные base LLM",
      "pipeline_tags": ["text-generation"],
      "model_kinds": ["base"],
      "min_downloads": 10,
      "sort_by": "downloads",
      "sort_direction": "desc",
      "limit": 100
    },
    {
      "name": "adapters_and_lora",
      "description": "Самые популярные adapters и LoRA",
      "model_kinds": ["adapter", "finetune"],
      "min_downloads": 10,
      "sort_by": "downloads",
      "sort_direction": "desc",
      "limit": 100
    },
    {
      "name": "llm_64_to_128b",
      "description": "LLM от 64B до 128B параметров",
      "min_parameters_b": 64,
      "max_parameters_b": 128,
      "sort_by": "downloads",
      "sort_direction": "desc",
      "limit": 100
    },
    {
      "name": "llm_7b_to_14b",
      "description": "LLM от 7B до 14B параметров",
      "min_parameters_b": 7,
      "max_parameters_b": 14,
      "sort_by": "downloads",
      "sort_direction": "desc",
      "limit": 100
    }
  ]
}
